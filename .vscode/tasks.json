{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Careflow project",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Create first hospital administrator",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/bootstrap-admin.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push project to GitHub",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}